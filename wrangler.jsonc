{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mibc-recruitment",
  "main": "worker.mjs",
  "account_id": "9c60761e8122777da502f4d81b373255",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/mibc-pulse/*", "/api/tm/*", "/ticketmanagement", "/ticketmanagement/*"],
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mibc-tickets",
      "database_id": "bd7a867c-cfb6-4e0b-940f-50b4651fcffc",
      "migrations_dir": "migrations"
    }
  ],
  // Banner ticket images, keyed by ticket code. Uploaded with `npm run tickets -- upload`.
  "kv_namespaces": [
    {
      "binding": "TICKET_IMAGES",
      "id": "6bad1162f438487d927d9721d3288a42"
    }
  ],
  // The mail queue sends one ticket email per minute.
  "triggers": {
    "crons": ["* * * * *"]
  },
  // The mailbox password is the SMTP_PASSWORD secret: `npx wrangler secret put SMTP_PASSWORD`.
  "vars": {
    "SMTP_HOST": "smtp.hostinger.com",
    "SMTP_PORT": "465",
    "SMTP_SECURE": "true",
    "SMTP_USER": "info@nsumibc.online",
    "MAIL_FROM_NAME": "NSU MIBC"
  }
}
