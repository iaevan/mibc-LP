{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mibc-recruitment",
  "main": "worker.mjs",
  "account_id": "9c60761e8122777da502f4d81b373255",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/mibc-pulse/*"],
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  }
}
