{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mibc-recruitment",
  "main": "worker.mjs",
  "account_id": "9c60761e8122777da502f4d81b373255",
  "compatibility_date": "2026-10-29",
  "workers_dev": true,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/mibc-pulse/*", "/api/tm/*", "/ticketmanagement", "/ticketmanagement/*"],
    "directory": "./out",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mibc-tickets",
      "database_id": "bd7a867c-cfb6-4e0b-940f-50b4651fcffc",
      "migrations_dir": "migrations"
    }
  ]
}
