{
  "name": "mibc-recruitment",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build && node scripts/check-site.mjs",
    "start": "serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "check:site": "node scripts/check-site.mjs",
    "deploy": "npm run build && wrangler deploy --no-autoconfig",
    "cloudflare:dev": "wrangler dev",
    "tickets": "node scripts/tickets.mjs",
    "db:migrate:local": "wrangler d1 migrations apply mibc-tickets --local",
    "db:migrate:remote": "wrangler d1 migrations apply mibc-tickets --remote"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "jsqr": "^1.4.0",
    "next": "^16.4.3",
    "posthog-js": "^1.444.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "wrangler": "^4.154.0"
  },
  "overrides": {
    "compression": "^1.8.2"
  }
}
